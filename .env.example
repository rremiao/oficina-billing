# Copie para .env e ajuste se precisar. Todos os valores têm default no docker-compose.yml.
BILLING_PORT=8081
POSTGRES_DB=billing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5673
RABBITMQ_PAINEL_PORT=15673
# Segredo HS256 do JWT: o mesmo da Lambda de autenticação e do OS Service (mínimo de 32 caracteres)
SECURITY_JWT_SECRET=jwt-local-secret-123456789012345678901234567890
MERCADOPAGO_URL=https://api.mercadopago.com
# Credenciais de teste da aplicação no painel do Mercado Pago (nunca commitar as reais)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
